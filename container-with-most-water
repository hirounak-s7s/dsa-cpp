class Solution {
public:
    int maxArea(vector<int>& height) {
        int water = 0;
        int left = 0;
        int right = height.size() - 1;
        int ans;
        while(left < right) {
        ans = (right - left)*min(height[left],height[right]);
        water = max(water,ans);
        if (height[left]<height[right]){
            left += 1;
            }
        else{
            right -= 1;
            }
        }
        return water;
    }
};
